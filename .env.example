# Local default uses SQLite. Railway can inject this value.
DATABASE_URL=sqlite:///data/clip_creator.db

# Local artifact storage root. Replace with object storage in the hosted product.
CLIP_CREATOR_DATA_DIR=data

# Default hook duration in seconds.
CLIP_CREATOR_HOOK_SECONDS=3

# PostBridge API integration. Add your real key to .env, not to source control.
POSTBRIDGE_API_KEY=
POSTBRIDGE_API_BASE_URL=https://api.post-bridge.com/v1

# Perplexity API for product research.
PERPLEXITY_API_KEY=

# OpenAI API for slideshow hooks + scripts.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini

# Supabase Auth, database, and Storage for saved product research.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-context

