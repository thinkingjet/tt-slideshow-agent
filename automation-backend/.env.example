# Railway API + worker
ENVIRONMENT=production
NODE_ENV=production
FRONTEND_URL=https://your-automation-frontend.vercel.app
REDIS_URL=redis://default:password@redis.railway.internal:6379/0

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Product research + slideshow draft generation
OPENAI_API_KEY=your_openai_key
OPENAI_SLIDESHOW_MODEL=gpt-4.1-mini
PERPLEXITY_API_KEY=your_perplexity_key
PERPLEXITY_AGENT_MODEL=perplexity/sonar

# Cloudflare R2 slideshow exports
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_CUSTOM_DOMAIN=cdn.reelstacks.ai

# Optional recovery
ENABLE_RECOVERY_SYSTEM=false
