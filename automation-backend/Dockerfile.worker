FROM python:3.11-slim

# Install system dependencies including OpenCV requirements
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libglib2.0-0 \
    libgtk2.0-dev \
    libavcodec-dev \
    libavformat-dev \
    libswscale-dev \
    libv4l-dev \
    libatlas-base-dev \
    gfortran \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create necessary directories with proper permissions
RUN mkdir -p /app/public/generated /app/temp && \
    chmod -R 755 /app/public/generated /app/temp && \
    chown -R root:root /app/public/generated /app/temp

# Set environment variables for better OpenCV performance
ENV OMP_NUM_THREADS=2
ENV OPENCV_DISABLE_GPU=1

# Run Celery worker with FIFO configuration on video_processing queue
CMD ["celery", "-A", "celery_worker", "worker", "--loglevel=info", "--concurrency=1", "--prefetch-multiplier=1", "--without-gossip", "--without-mingle", "--without-heartbeat", "--queues=video_processing"] 